# ===============================================
# CONFIGURAZIONE DATABASE MONGODB ATLAS
# ===============================================

# URI di connessione a MongoDB Atlas
# Formato: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/viaggi_gruppo?retryWrites=true&w=majority

# Nome del database
MONGODB_DB=viaggi_gruppo

# ===============================================
# CONFIGURAZIONE FLASK
# ===============================================

# Ambiente (development, testing, production)
FLASK_ENV=development

# Chiave segreta per sessioni e token (genera una stringa casuale sicura)
SECRET_KEY=your-super-secret-key-change-in-production

# ===============================================
# CONFIGURAZIONE APPLICAZIONE
# ===============================================

# Porta su cui esegue il server Flask
FLASK_PORT=5000

# Host (localhost per sviluppo)
FLASK_HOST=localhost
